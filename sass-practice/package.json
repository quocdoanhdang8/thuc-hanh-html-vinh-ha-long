{
  "name": "sass-practice",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sass:version": "sass --version",
    "build": "sass scss/styles.scss css/styles.css",
    "watch": "sass scss/styles.scss css/styles.css --watch",
    "build:all": "sass scss/:css/ --no-source-map",
    "watch:all": "sass scss/:css/ --watch"
  },
  "devDependencies": {
    "sass": "^1.93.2"
  }
}
